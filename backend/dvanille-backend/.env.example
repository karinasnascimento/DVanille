# ============================================================
# D'Vanille Backend - variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env".
# ============================================================

NODE_ENV="development"
PORT=3000

# Conexão MySQL (formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dvanille"

# JWT - em produção use um segredo aleatório com 32+ caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_THIS_SECRET"
JWT_EXPIRES_IN="7d"

# Origens permitidas no CORS, separadas por vírgula (Web, painel admin, Flutter Web...).
# O app Flutter mobile não envia "Origin", então não depende desta lista.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# Upload de imagens (armazenamento local)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Segurança
BCRYPT_ROUNDS=10
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Regras de negócio
DELIVERY_FEE=8.00
FREE_DELIVERY_MIN_ORDER=0
LOYALTY_POINTS_PER_REAL=1

# Pagamentos (simulado no TCC; trocar por gateway real no futuro)
PAYMENT_GATEWAY="simulated"
ALLOW_PAYMENT_SIMULATION=true

# Senhas usadas APENAS pelo seed de desenvolvimento (prisma/seed.js)
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_CUSTOMER_PASSWORD="Cliente@123456"
